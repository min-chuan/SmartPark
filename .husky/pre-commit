#!/usr/bin/env sh

# 获取暂存的文件
STAGED_FILES=$(git diff --cached --name-only --diff-filter=ACM "*.ts" "*.tsx" "*.js" "*.jsx" "*.css" "*.scss" "*.json" "*.md" "*.html" 2>/dev/null)

# 如果有暂存的文件，运行 Prettier 格式化
if [ -n "$STAGED_FILES" ]; then
  echo "🎨 Running Prettier on staged files..."
  echo "$STAGED_FILES" | xargs npx prettier --write --ignore-unknown
  
  # 将格式化后的文件重新添加到暂存区
  echo "$STAGED_FILES" | xargs git add 2>/dev/null
  echo "✅ Prettier 格式化完成"
fi

# 运行 ESLint 检查
echo "🔍 Running ESLint..."
npm run lint -- --quiet

# 如果 ESLint 检查失败，阻止提交
if [ $? -ne 0 ]; then
  echo "❌ ESLint 检查失败，请修复错误后再提交"
  exit 1
fi

echo "✅ ESLint 检查通过"
